# Sao chép thành .env và điền giá trị. Không commit .env.

# Mật khẩu chỉ gồm chữ và số, không chứa @ : / ? # % (vì được ghép vào URL kết nối).
POSTGRES_PASSWORD=doimatkhaunay
# Khóa ký token đăng nhập: chuỗi ngẫu nhiên dài, ví dụ: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=doi-khoa-nay
# Tài khoản trụ sở đầu tiên, tạo khi api khởi động lần đầu (chỉ khi chưa có nhân viên trụ sở nào)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=doimatkhaunay

# Cổng mở ra máy host; đổi nếu trùng với dự án khác đang chạy
DB_PORT=5432
API_PORT=8000
WEB_PORT=3000
